// Left-side dock for mango (replaces the DMS dock): click minimizes/restores, like macOS.
// The icons (pinned apps + the taskbar) come from modules.jsonc, which dock-pin writes from
// pins.json: pin or unpin the focused app with Super+Shift+P, right click a pinned icon to unpin.
{
  "name": "dock",
  "layer": "overlay",
  "position": "left",
  "exclusive": false,
  "start_hidden": true,
  "width": 56,
  "margin-left": 6,
  "include": ["~/.config/waybar/dock/modules.jsonc"]
}
