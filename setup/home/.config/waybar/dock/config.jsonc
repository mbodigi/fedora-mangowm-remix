// Left-side dock for mango (replaces the DMS dock): click minimizes/restores, like macOS
{
  "name": "dock",
  "layer": "overlay",
  "position": "left",
  "exclusive": false,
  "start_hidden": true,
  "width": 56,
  "margin-left": 6,
  "modules-center": ["wlr/taskbar"],
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 36,
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close",
    "ignore-list": ["dev.dropdown.ghostty"]
  }
}
