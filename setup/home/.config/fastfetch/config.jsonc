// fastfetch: Fedora logo as a real image (Ghostty supports the kitty image protocol), info with icons.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/vayu.png",
    "width": 22,
    "height": 10,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "white" }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}@{host-name-colored}" },
    "separator",
    { "type": "os", "key": "󰖝 OS" },
    { "type": "kernel", "key": " Kernel" },
    { "type": "wm", "key": " WM" },
    { "type": "shell", "key": " Shell" },
    { "type": "terminal", "key": " Term" },
    { "type": "packages", "key": "󰏖 Pkgs" },
    { "type": "uptime", "key": "󰅐 Up" },
    { "type": "cpu", "key": " CPU" },
    { "type": "memory", "key": " RAM" },
    { "type": "disk", "key": "󰋊 Disk", "folders": "/" },
    { "type": "battery", "key": "󰁹 Batt" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
