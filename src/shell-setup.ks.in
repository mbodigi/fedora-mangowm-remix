# Fedora 44 + our MangoWM/Quickshell desktop, installed offline from the packages on the ISO.
# Language, keyboard, disk, time zone and the user are left to the installer screens (next, next, finish).
# pack.sh fills in @PACKAGES@ and writes build/shell-setup.ks.

graphical

# Network (not needed to install): DHCP on the first cable with a link; Wi-Fi can be set in "Network & Host Name".
# The connection used here is copied to the installed system.
network --device=link --bootproto=dhcp --activate --onboot=yes

# Offline: every package comes from /shellrepo on the ISO (the boot menu passes
# inst.repo=hd:LABEL=...:/shellrepo). The installed system gets the normal online repo files
# for later updates.

# bootloader: picked per machine by %pre below
%include /tmp/bootloader.ks
selinux --enforcing
firewall --enabled
firstboot --disable
services --enabled=NetworkManager,greetd,tuned

# systemd-boot (like the original machine) on UEFI without Secure Boot. It isn't signed, so with
# Secure Boot on, and on old BIOS machines, use GRUB (signed shim on UEFI) instead.
%pre
sb=$(od -An -t u1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | awk '{print $NF}')
if [ -d /sys/firmware/efi ] && [ "$sb" != 1 ]; then
    echo "bootloader --sdboot" > /tmp/bootloader.ks
else
    echo "bootloader" > /tmp/bootloader.ks
fi
%end

%packages
@PACKAGES@
%end

# The bundle (configs, greeter, policies, wallpapers) is on the ISO; copy it into the new system.
%post --nochroot --erroronfail
set -e
for d in /run/install/repo /run/install/sources/mount-*-cdrom /run/install/isodir; do
    [ -f "$d/shell-bundle.tar.gz" ] && { cp "$d/shell-bundle.tar.gz" /mnt/sysroot/tmp/; exit 0; }
done
mkdir -p /tmp/shellmedia
for dev in /dev/disk/by-label/*; do
    mount -o ro "$dev" /tmp/shellmedia 2>/dev/null || continue
    if [ -f /tmp/shellmedia/shell-bundle.tar.gz ]; then
        cp /tmp/shellmedia/shell-bundle.tar.gz /mnt/sysroot/tmp/
        umount /tmp/shellmedia
        exit 0
    fi
    umount /tmp/shellmedia
done
echo "shell-bundle.tar.gz not found on the install media" >&2
exit 1
%end

%post --erroronfail --log=/root/shell-setup-post.log
set -ex
mkdir -p /tmp/shell-bundle
tar -xzf /tmp/shell-bundle.tar.gz -C /tmp/shell-bundle
B=/tmp/shell-bundle

# system files: greeter, greetd, browser policies, LibreWolf defaults, battery rule, tuned, repos, helper scripts
# owned by root, and existing directories (/, /etc, /usr...) keep their owner and mode:
# a plain cp -a would hand them to whoever built the bundle
(cd "$B/root" && tar -cf - --owner=0 --group=0 --numeric-owner .) | tar -xf - -C / --no-overwrite-dir
mkdir -p /usr/share/shell-setup
cp -r "$B/home" "$B/greeter-cache" /usr/share/shell-setup/
chown -R root:root /usr/share/shell-setup

# the login screen's account and its home (must exist before users get the greeter cache)
systemd-sysusers shell-greeter.conf
systemd-tmpfiles --create shell-greeter.conf
restorecon -RF /var/lib/greeter || true

# the login screen's theme cache keeps the label it has on the original machine
semanage fcontext -a -t cache_home_t '/var/cache/shell-greeter(/.*)?' || true
restorecon -RF /etc /usr/local /usr/share/shell-setup /usr/share/librewolf || true

systemctl enable greetd
systemctl set-default graphical.target

# give every user created in the installer the desktop
getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' | while read -r u; do
    /usr/local/bin/shell-user-setup "$u"
done

rm -rf /tmp/shell-bundle /tmp/shell-bundle.tar.gz
%end
